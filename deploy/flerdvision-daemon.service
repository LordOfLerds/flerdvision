# Flerdvision — autonomer Posting-Daemon fuer die Brother-VPS-Installation.
#
# Code ist immutable unter /opt/flerdvision/releases/<sha>; /opt/flerdvision/current ist nur der
# atomar umschaltbare Symlink auf die freigegebene Release-SHA. Config/Secrets und Runtime-State
# liegen ausserhalb des Releases und werden bei Updates nie kopiert.
#
# Final publishing bleibt dreifach fail-closed:
#   1. ALLOW_FINAL_PUBLISH=true in /etc/flerdvision/secrets.env,
#   2. --confirm AUTONOMOUS_FINAL_PUBLISH ist in dieser Unit explizit verdrahtet,
#   3. FLERDVISION_DAEMON_CHANNEL_ARGS muss mindestens einen erlaubten Kanal enthalten.
# FLERDVISION_DAEMON_MODE startet als canary und wird erst nach Brother-Canary auf production
# umgestellt. FLERDVISION_WORKSPACE_ROLE bleibt production; test-now ist damit auf diesem Host tot.

[Unit]
Description=Flerdvision autonomous posting daemon
Wants=network-online.target
After=network-online.target flerdvision-xvfb.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=flerdvision
Group=flerdvision
WorkingDirectory=/opt/flerdvision/current
EnvironmentFile=/etc/flerdvision/secrets.env
EnvironmentFile=/etc/flerdvision/release.env
Environment=NODE_ENV=production
Environment=DISPLAY=:99
Environment=XDG_CACHE_HOME=/var/lib/flerdvision/cache
ExecStart=/usr/bin/node /opt/flerdvision/current/dist/cli/flerdvision.js daemon --mode $FLERDVISION_DAEMON_MODE --confirm AUTONOMOUS_FINAL_PUBLISH --interval 60 $FLERDVISION_DAEMON_CHANNEL_ARGS
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flerdvision /var/backups/flerdvision
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

# Flerdvision VPS environment template for /etc/flerdvision/secrets.env.
# Mode 640, owner root:flerdvision. NEVER commit a filled copy.

TZ=Europe/Vienna

# Canonical business spec; workspace.runtimeRoot must be absolute on VPS.
FLERDVISION_SPEC=/etc/flerdvision/flerdvision.json

# Brother VPS is production-role. This permanently disables acceptance-only test-now.
FLERDVISION_WORKSPACE_ROLE=production

# Start the installed daemon as canary. Change to production only after the Brother canary gate.
FLERDVISION_DAEMON_MODE=canary

# Pinned Chrome for Testing installed by deploy/install-vps.sh.
CHROMIUM_EXECUTABLE_PATH=/opt/chrome/current/chrome
#FFPROBE_EXECUTABLE_PATH=/usr/bin/ffprobe

# Google OAuth Desktop client for this installation only. Brother authorizes his own Drive;
# no Luca refresh token/profile/database is copied to this host.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# Brother's Telegram operator channel only.
FLERDVISION_TELEGRAM_BOT_TOKEN=REPLACE_ME
FLERDVISION_TELEGRAM_CHAT_ID=REPLACE_ME

# Authenticated/private remote browser URL (tailnet/SSO/access gateway). It must lead to the
# loopback-only noVNC endpoint through an authenticated layer. Never expose :6080 publicly.
#FLERDVISION_REMOTE_SCREEN_URL=https://browser.example.internal/

# Independent irreversible publish gate. Keep false through setup/qualification.
# Set true only when the Brother canary is explicitly authorized.
ALLOW_FINAL_PUBLISH=false

# Explicit daemon allowlist. Repeat --channel for every channel managed by this installation.
FLERDVISION_DAEMON_CHANNEL_ARGS=--channel instagram-flerdvision

# Optional runtime controls.
FLERDVISION_SCREENCAST=1
FLERDVISION_DAEMON_HEADLESS=1
#FLERDVISION_LOGIN_TIMEOUT_MINUTES=30
#FLERDVISION_DRIVE_OAUTH_PORT=8765
#FLERDVISION_VERIFICATION_TIMEOUT_SECONDS=180
#FLERDVISION_VERIFICATION_POLL_SECONDS=10

# FLERDVISION_RELEASE_SHA is NOT stored here. install/update writes the exact SHA to release.env.

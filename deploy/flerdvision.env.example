# Flerdvision VPS-Umgebung — Vorlage fuer /etc/flerdvision/flerdvision.env (Mode 600, Owner flerdvision).
# NIEMALS eine ausgefuellte Kopie ins Repo committen. Jede Variable hier wird nachweislich vom
# Code gelesen (Fundstelle in Klammern).

# Zeitzone des Geschaeftsplans (AGENTS.md: Europe/Vienna ist die Business-Scheduling-Zeitzone).
TZ=Europe/Vienna

# Kanonische Spec-Datei (src/cli/flerdvision.ts: canonicalSpecPath liest FLERDVISION_SPEC).
# Auf dem VPS MUSS workspace.runtimeRoot in dieser Datei ABSOLUT sein
# (z. B. /var/lib/flerdvision/runtime) — der Code aufloest relativ zum Prozess-CWD.
FLERDVISION_SPEC=/etc/flerdvision/flerdvision.json

# Pinned Chrome for Testing (src/adapters/browser/resolve-chromium.ts:
# CHROMIUM_EXECUTABLE_PATH wird honoriert, sonst Distro-Kandidaten).
CHROMIUM_EXECUTABLE_PATH=/opt/chrome/current/chrome

# Optional: ffprobe wird sonst ueber /usr/bin/ffprobe bzw. PATH gefunden
# (src/adapters/media/resolve-ffprobe.ts liest FFPROBE_EXECUTABLE_PATH).
#FFPROBE_EXECUTABLE_PATH=/usr/bin/ffprobe

# Google-OAuth-Client (Desktop app) fuer die Drive-Quelle — Pflicht fuer bootstrap/drive-auth,
# sobald ein Drive-Credential existiert (src/application/headless-bootstrap.ts liest
# GOOGLE_OAUTH_CLIENT_ID/GOOGLE_OAUTH_CLIENT_SECRET). Anlegen laut docs/23 Abschnitt 4.
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME

# Telegram-Operator-Kanal (src/adapters/notify/telegram.ts: telegramAdapterFromEnv liest
# FLERDVISION_TELEGRAM_BOT_TOKEN und FLERDVISION_TELEGRAM_CHAT_ID). Test: notify-test.
FLERDVISION_TELEGRAM_BOT_TOKEN=REPLACE_ME
FLERDVISION_TELEGRAM_CHAT_ID=REPLACE_ME

# HARTE PUBLIKATIONS-SPERRE (src/cli/flerdvision.ts: authorizedMode; AGENTS.md:
# "macOS/VPS installation keeps ALLOW_FINAL_PUBLISH=false").
# Auf true stellen ist die explizite Canary-Autorisierung NACH der Qualifikationsleiter aus
# docs/23 (PREPARE_ONLY gruen auf exakter Release-SHA, ggf. private E2E, ein run-once-Canary).
ALLOW_FINAL_PUBLISH=false

# Kanal-Allowlist fuer den Daemon; wird in der systemd-Unit unquoted expandiert, mehrere Kanaele
# als wiederholte Flags: "--channel instagram-flerdvision --channel tiktok-flerdvision".
FLERDVISION_DAEMON_CHANNEL_ARGS=--channel instagram-flerdvision

# Optionale Stellschrauben (alle mit Code-Fundstelle):
# Login-Fenster in Minuten, 1..120 (src/cli/flerdvision.ts liest FLERDVISION_LOGIN_TIMEOUT_MINUTES).
#FLERDVISION_LOGIN_TIMEOUT_MINUTES=30
# Loopback-Port fuer drive-auth, Default 8765 (src/cli/flerdvision.ts / headless-drive-auth.ts).
#FLERDVISION_DRIVE_OAUTH_PORT=8765
# Verifikationsfenster nach dem finalen Klick (src/application/headless-demo.ts, 30..900 / 5..60).
#FLERDVISION_VERIFICATION_TIMEOUT_SECONDS=180
#FLERDVISION_VERIFICATION_POLL_SECONDS=10

# FLERDVISION_RELEASE_SHA absichtlich NICHT hier: die gepinnte Release-SHA schreibt
# deploy/update-release.sh nach /etc/flerdvision/release.env.

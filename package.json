{
  "name": "flerdvision",
  "version": "0.2.0-headless",
  "private": true,
  "type": "module",
  "description": "Headless, autonomous and evidence-verified social publishing runtime for Flerdvision.",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:focused": "npm run build && node --test",
    "test:core": "npm run build && node --test tests/portability.test.mjs tests/headless-workspace-spec.test.mjs tests/headless-compiler.test.mjs tests/headless-product-path.test.mjs tests/a3-incident-reconciliation.test.mjs",
    "test:platform": "npm run build && node --test tests/headless-surface-agent-safety.test.mjs tests/headless-surface-contract.test.mjs tests/w4-*.test.mjs tests/w8-*.test.mjs",
    "test:full": "npm test",
    "test:repair": "npm run build && node --test tests/r*.test.mjs tests/completeness-gate.test.mjs",
    "check": "npm run test:full",
    "flerdvision": "npm run build && node dist/cli/flerdvision.js",
    "start": "npm run flerdvision -- auto",
    "demo": "npm run flerdvision -- demo",
    "runtime": "npm run build && node dist/cli/runtime.js",
    "runtime-planning": "npm run build && node dist/cli/runtime-planning.js",
    "runtime-status": "npm run build && node dist/cli/runtime-status.js",
    "qualification": "npm run build && node dist/cli/qualification.js",
    "repair": "npm run build && node dist/cli/repair.js",
    "ai-provider": "npm run build && node dist/cli/ai-provider.js",
    "workspace": "npm run build && node dist/cli/workspace.js",
    "browser": "npm run build && node dist/cli/browser.js",
    "source-activation": "npm run build && node dist/cli/source-activation.js",
    "admin": "npm run build && node dist/cli/admin.js",
    "legacy:control-center": "npm run build && node dist/cli/control-center.js",
    "legacy:setup-ui": "npm run build && node dist/cli/setup-ui.js",
    "legacy:ops": "npm run build && node dist/cli/ops.js",
    "legacy:platform-ui": "npm run build && node dist/cli/platform-ui.js",
    "legacy:e2e": "npm run build && node dist/cli/e2e.js",
    "test:w1": "npm run build && node --test tests/w1-*.test.mjs",
    "test:w2": "npm run build && node --test tests/w2-*.test.mjs",
    "test:w3": "npm run build && node --test tests/w3-*.test.mjs",
    "test:w4": "npm run build && node --test tests/w4-*.test.mjs",
    "test:w5": "npm run build && node --test tests/w5-*.test.mjs",
    "test:w6": "npm run build && node --test tests/w6-*.test.mjs",
    "test:w7": "npm run build && node --test tests/w7-*.test.mjs",
    "test:w8": "npm run build && node --test tests/w8-*.test.mjs",
    "test:w8a": "npm run build && node --test tests/w8a-*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}

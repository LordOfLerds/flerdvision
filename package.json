{
  "name": "flerdvision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UI-native, adapter-driven social publishing control plane for Flerdvision.",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "admin": "npm run build && node dist/cli/admin.js",
    "test:w1": "npm run build && node --test tests/w1-*.test.mjs",
    "test:w2": "npm run build && node --test tests/w2-*.test.mjs",
    "browser": "npm run build && node dist/cli/browser.js",
    "test:w3": "npm run build && node --test tests/w3-*.test.mjs",
    "test:w4": "npm run build && node --test tests/w4-*.test.mjs",
    "platform-ui": "npm run build && node dist/cli/platform-ui.js"
  },
  "engines": {
    "node": ">=22"
  }
}

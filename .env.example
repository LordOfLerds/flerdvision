# Safe default: no final publish action is permitted.
FLERDVISION_MODE=disabled
TZ=Europe/Vienna
DATABASE_URL=file:./runtime/flerdvision.sqlite
RUNTIME_DIR=./runtime
BROWSER_PROFILE_DIR=./profiles
EVIDENCE_DIR=./artifacts/evidence
# Comma-separated stable internal account IDs. Empty means none.
ALLOWED_PUBLISH_ACCOUNT_IDS=
# Separate hard gate; production code must require BOTH mode and this flag.
ALLOW_FINAL_PUBLISH=false

# W2 ingress. Root ID is deployment data, never source-controlled with customer identifiers.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SOURCE_ID=current_google_drive
# Safe default: source completion has no external side effect until an adapter is deliberately selected.
SOURCE_DISPOSITION_ADAPTER=noop
SOURCE_DISPOSITION_WEBHOOK_URL=
